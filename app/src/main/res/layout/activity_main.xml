<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_warm">

    <!-- Fragment Host -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/navHostFragment"
        android:name="androidx.navigation.fragment.NavHostFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottomNavContainer"
        app:defaultNavHost="true"
        app:navGraph="@navigation/nav_graph" />

    <!-- Bottom Nav Container -->
    <RelativeLayout
        android:id="@+id/bottomNavContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="@color/bg_warm">

        <!-- Fixed 72dp Content Area for Bottom Bar -->
        <RelativeLayout
            android:id="@+id/navBarContent"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:background="@color/bg_warm">

            <com.google.android.material.bottomnavigation.BottomNavigationView
                android:id="@+id/bottomNavView"
                style="@style/Widget.MaterialComponents.BottomNavigationView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/bg_warm"
                app:elevation="0dp"
                app:itemIconSize="22dp"
                app:itemIconTint="@color/nav_item_color"
                app:itemTextColor="@color/nav_item_color"
                app:labelVisibilityMode="labeled"
                app:menu="@menu/bottom_nav_menu" />

            <!-- Center Floating Action Button -->
            <FrameLayout
                android:id="@+id/btnCenterFocus"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_centerInParent="true"
                android:background="@drawable/bg_circle_floating_action"
                android:clickable="true"
                android:elevation="8dp"
                android:focusable="true">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_play_arrow"
                    app:tint="@color/white" />

            </FrameLayout>

        </RelativeLayout>

    </RelativeLayout>
</RelativeLayout>
