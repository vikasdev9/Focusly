<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingVertical="12dp">

    <!-- Top Graphic Circle Container -->
    <FrameLayout
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:layout_gravity="center_horizontal">

        <!-- Outer Background Circle -->
        <View
            android:id="@+id/viewCircleBg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_onboarding_circle_green" />

        <!-- Inner Badge Container (For Pages 2 & 3) -->
        <FrameLayout
            android:id="@+id/frameInnerBadge"
            android:layout_width="84dp"
            android:layout_height="84dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_onboarding_badge"
            android:elevation="4dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/imgBadgeIcon"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_timer"
                app:tint="@color/forest_dark" />
        </FrameLayout>

        <!-- Plant Illustration (For Page 1) -->
        <ImageView
            android:id="@+id/imgPlantHero"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:src="@drawable/ic_plant_hero" />

    </FrameLayout>

    <!-- Tagline Header -->
    <TextView
        android:id="@+id/tvOnboardingTag"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:letterSpacing="0.1"
        android:text="@string/onboarding_1_tag"
        android:textColor="@color/muted_text"
        android:textSize="12sp"
        android:textStyle="bold" />

    <!-- Main Title -->
    <TextView
        android:id="@+id/tvOnboardingTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/onboarding_1_title"
        android:textColor="@color/charcoal"
        android:textSize="26sp"
        android:textStyle="bold" />

    <!-- Subtitle / Description -->
    <TextView
        android:id="@+id/tvOnboardingSub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:lineSpacingExtra="3dp"
        android:text="@string/onboarding_1_sub"
        android:textColor="@color/muted_text"
        android:textSize="14sp" />

</LinearLayout>
