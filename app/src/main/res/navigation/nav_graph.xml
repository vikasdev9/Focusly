<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/nav_splash">

    <fragment
        android:id="@+id/nav_splash"
        android:name="com.focusly.app.presentation.splash.SplashFragment"
        android:label="Splash">
        <action
            android:id="@+id/action_splash_to_onboarding"
            app:destination="@id/nav_onboarding"
            app:popUpTo="@id/nav_splash"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_splash_to_home"
            app:destination="@id/nav_home"
            app:popUpTo="@id/nav_splash"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/nav_onboarding"
        android:name="com.focusly.app.presentation.onboarding.OnboardingFragment"
        android:label="Onboarding">
        <action
            android:id="@+id/action_onboarding_to_home"
            app:destination="@id/nav_home"
            app:popUpTo="@id/nav_onboarding"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/nav_home"
        android:name="com.focusly.app.presentation.home.HomeFragment"
        android:label="Home" />

    <fragment
        android:id="@+id/nav_insights"
        android:name="com.focusly.app.presentation.insights.InsightsFragment"
        android:label="Insights" />

    <fragment
        android:id="@+id/nav_focus"
        android:name="com.focusly.app.presentation.focus.FocusFragment"
        android:label="Focus" />

    <fragment
        android:id="@+id/nav_world"
        android:name="com.focusly.app.presentation.world.WorldFragment"
        android:label="Plants" />

    <fragment
        android:id="@+id/nav_profile"
        android:name="com.focusly.app.presentation.profile.ProfileFragment"
        android:label="Profile" />

    <fragment
        android:id="@+id/nav_blocking"
        android:name="com.focusly.app.presentation.blocking.AppBlockingFragment"
        android:label="App Blocking" />

    <fragment
        android:id="@+id/nav_routines"
        android:name="com.focusly.app.presentation.routines.RoutineListFragment"
        android:label="Routines" />

    <fragment
        android:id="@+id/nav_habits"
        android:name="com.focusly.app.presentation.habits.HabitListFragment"
        android:label="Habits" />

    <fragment
        android:id="@+id/nav_subscription"
        android:name="com.focusly.app.presentation.subscription.SubscriptionFragment"
        android:label="Subscription" />

</navigation>
